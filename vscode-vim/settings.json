{
  "zenMode.hideLineNumbers": false,
  "editor.fontFamily": "CodeNewRoman Nerd Font Mono",
  "workbench.settings.editor": "json",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "editor.lineNumbers": "relative",
  "editor.fontSize": 14,
  "editor.linkedEditing": true,
  "editor.fontLigatures": true,
  "git.openRepositoryInParentFolders": "never",
  "editor.tabSize": 2,
  "editor.cursorSurroundingLines": 8,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "editor.minimap.enabled": false,
  "extensions.ignoreRecommendations": true,
  "editor.stickyScroll.enabled": false,
  "workbench.editor.showTabs": "none",
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "terminal.integrated.fontSize": 16,


  "vim.foldfix": true,
  "vim.useCtrlKeys": true,
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.commandLineModeKeyBindingsNonRecursive": [],
  "vim.normalModeKeyBindings": [
    { "before": [ "<C-z>" ], "commands": [ "workbench.action.toggleZenMode" ], "silent": true },
    { "before": [ "<C-s>" ], "commands": [ ":w" ], "silent": true },
    { "before": [ "<C-q>" ], "commands": [ ":q" ], "silent": true },
    { "before": [ "H" ], "after": [ "^" ], "silent": true },
    { "before": [ "L" ], "after": [ "$" ], "silent": true },
    { "before": [ "n" ], "after": [ "n", "z", "z" ], "silent": true },
    { "before": [ "N" ], "after": [ "N", "z", "z" ], "silent": true },
    { "before": [ "P" ], "after": [ "\"", "+", "p" ], "silent": true },
    { "before": [ "<C-n>" ], "commands": [ "workbench.action.nextEditor" ], "silent": true },
    { "before": [ "<C-p>" ], "commands": [ "workbench.action.previousEditor" ], "silent": true },
    { "before": [ "<C-j>" ], "commands": [ "workbench.action.navigateDown" ], "silent": true },
    { "before": [ "<C-k>" ], "commands": [ "workbench.action.navigateUp" ], "silent": true },
    { "before": [ "<C-l>" ], "commands": [ "workbench.action.navigateRight" ], "silent": true },
    { "before": [ "<C-h>" ], "commands": [ "workbench.action.navigateLeft" ], "silent": true },
    { "before": [ "<leader>", "n" ], "commands": [ ":nohl" ], "silent": true },
    { "before": [ "g", "[" ], "commands": [ "workbench.action.editor.nextChange" ], "silent": true },
    { "before": [ "g", "]" ], "commands": [ "workbench.action.editor.previousChange" ], "silent": true },
    { "before": [ "g", "R" ], "commands": [ "editor.action.rename" ], "silent": true },
    { "before": [ "g", "d" ], "commands": [ "editor.action.revealDefinition" ], "silent": true },
    { "before": [ "g", "i" ], "commands": [ "editor.action.goToImplementation" ], "silent": true },
    { "before": [ "g", "r" ], "commands": [ "editor.action.goToReferences" ], "silent": true },
    { "before": [ "<leader>", "d" ], "commands": [ { "command": "workbench.action.closeActiveEditor", "when": "editorTextFocus" } ], "silent": true },
    { "before": [ "<leader>", "f", "f" ], "commands": [ "workbench.action.quickOpen" ], "silent": true },
    { "before": [ "<leader>", "f", "r" ], "commands": [ "workbench.action.showAllEditors" ], "silent": true },
    { "before": [ "<leader>", "l", "a" ], "commands": [ "editor.action.quickFix" ], "silent": true },
    { "before": [ "<leader>", "l", "f" ], "commands": [ "editor.action.formatDocument" ], "silent": true },
    { "before": [ "<leader>", "l", "k" ], "commands": [ "editor.action.showHover" ], "silent": true },
    { "before": [ "<leader>", "l", "d" ], "commands": [ "editor.action.peekDefinition" ], "silent": true },
    { "before": [ "<leader>", "l", "D" ], "commands": [ "editor.action.peekTypeDefinition" ], "silent": true },
    { "before": [ "<leader>", "l", "i" ], "commands": [ "editor.action.peekImplementation" ], "silent": true },
    { "before": [ "<leader>", "l", "I" ], "commands": [ "editor.action.peekDeclaration" ], "silent": true },
    { "before": [ "<leader>", "l", "r" ], "commands": [ "editor.action.referenceSearch.trigger" ], "silent": true },
    { "before": [ "<leader>", "g", "b" ], "commands": [ "git.checkout" ], "silent": true },
    { "before": [ "<leader>", "g", "H" ], "commands": [ "git.viewHistory" ], "silent": true },
    { "before": [ "<leader>", "g", "h" ], "commands": [ "git.viewFileHistory" ], "silent": true },
    { "before": [ "<leader>", "b", "c" ], "commands": [ "workbench.action.closeOtherEditors" ], "silent": true },
  ],
  "vim.insertModeKeyBindings": [],
  "vim.visualModeKeyBindings": [
    { "before": [ "Y" ], "after": [ "\"", "+", "y" ], "silent": true },
    { "before": [ "*" ], "after": [ "y", "/", "<c-r>", "\"", "<Enter>" ], "silent": true },
    { "before": [ "<leader>", "l", "f" ], "commands": [ "editor.action.formatSelection" ], "silent": true }
  ],
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": true,
    "<C-z>": true,
    "<C-a>": true,
    "<C-f>": true,
    "<C-b>": false
  },
  "vim.easymotion": false,
  "vim.surround": true,
  "vim.sneak": true
}