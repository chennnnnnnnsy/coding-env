  {
    "command": "germanScroll.bertholdUp",
    "key": "ctrl+u",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "command": "germanScroll.bertholdDown",
    "key": "ctrl+d",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+s",
    "command": "-vscode-neovim.send",
    "when": "editorTextFocus && neovim.ctrlKeysNormal.s && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save",
    "when": "editorTextFocus && neovim.mode == 'normal'" // 普通模式
  },
  {
    "key": "space t t",
    "command": "auto-i18n-tool.translate",
    "when": "editorTextFocus && neovim.mode == 'visual'" // 可视模式
  },
  {
    "key": "ctrl+n",
    "command": "-cursorDown",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+p",
    "command": "-vscode-neovim.send",
    "when": "editorTextFocus && neovim.ctrlKeysNormal.p && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'"
  },
  {
    "key": "ctrl+p",
    "command": "-cursorUp",
    "when": "textInputFocus"
  },
  {
    "command": "workbench.action.nextEditor",
    "key": "ctrl+n",
    "when": "editorTextFocus && neovim.mode == 'normal' && !suggestWidgetVisible"
  },
  {
    "command": "workbench.action.previousEditor",
    "key": "ctrl+p",
    "when": "editorTextFocus && neovim.mode == 'normal' && !suggestWidgetVisible"
  },
]
